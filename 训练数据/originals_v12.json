[
{"t":"塞上","g":"五绝","u":["霜刀映月寒","铁马蹴冰滩","一夜征人梦","飞度陇云看"]},
{"t":"江南","g":"五绝","u":["水暖凫初泳","桑柔燕正忙","吴船载新酒","一路棹歌长"]},
{"t":"采莲","g":"五绝","u":["荷叶乱田田","歌声隔水传","撑篙莫惊起","鸳鸯正并眠"]},
{"t":"渔父","g":"五绝","u":["一棹入烟波","芦花深处歌","得鱼换村酒","醉倒夕阳多"]},
{"t":"客里重九","g":"五绝","u":["客里逢重九","东篱菊自黄","登高莫回首","处处是他乡"]},
{"t":"七夕","g":"五绝","u":["河汉夜沉沉","佳期何处寻","人间一夕话","天上一年深"]},
{"t":"咏柳","g":"五绝","u":["新柳拂堤斜","春风千万家","不知谁裁出","叶叶是烟霞"]},
{"t":"咏蝉","g":"五绝","u":["饮露立高枝","清声风递迟","不平鸣自远","岂为世人知"]},
{"t":"闺怨","g":"五绝","u":["烛尽夜迢迢","罗帏梦寂寥","征鸿过不尽","字字写无聊"]},
{"t":"苦热","g":"五绝","u":["赤日炙长空","云峰立火中","安得挟雷雨","滂沱洗碧穹"]},
{"t":"访友不遇","g":"五绝","u":["叩门无犬吠","篱下菊初黄","不遇亦佳事","青山自夕阳"]},
{"t":"闻笛","g":"五绝","u":["谁家玉笛声","吹彻洛阳城","此夜关山月","人人故园情"]},
{"t":"春日","g":"七绝","u":["草色初青柳色黄","莺声惊破晓梦长","东君着意匀新绿","先到小园桃杏旁"]},
{"t":"夏晚","g":"七绝","u":["荷风忽送晚凉来","池上月华镜乍开","何处笛声吹最远","一庭萤火逐人回"]},
{"t":"秋暮","g":"七绝","u":["霜落江头木叶稀","寒鸦背日向山飞","行人莫问前朝事","只有秋声上客衣"]},
{"t":"冬晴","g":"七绝","u":["腊日晴熏小阁窗","残梅犹有雪中香","儿童笑指檐前雀","也趁晴喧弄晚光"]},
{"t":"塞下曲","g":"七绝","u":["饮马寒沙夜月低","霜风卷地马频嘶","遥怜帐外三更雪","冷浸弓刀天地迷"]},
{"t":"宫词","g":"七绝","u":["永巷沉沉漏渐稀","君王恩宠似春晖","落花不管人间恨","犹傍残妆作雪飞"]},
{"t":"送春","g":"七绝","u":["九十春光一夜空","枝头不见旧时红","啼鹃莫诉春归去","且待薰风麦浪中"]},
{"t":"中秋","g":"七绝","u":["玉宇无尘桂子寒","冰轮出海一宵宽","天涯今夜同回首","都在婵娟影里看"]},
{"t":"登高","g":"七绝","u":["万壑风多不可留","白云红叶两悠悠","凭高莫问兴亡事","输与江声日夜流"]},
{"t":"夜泊","g":"七绝","u":["暝色苍茫下钓矶","芦花瑟瑟雁南飞","舟人夜语潮声急","月落青山送客归"]},
{"t":"咏瀑布","g":"七绝","u":["绝壁千寻走白龙","风雷日夜斗山中","何当化作人间雨","洗尽炎尘万里空"]},
{"t":"咏镜","g":"七绝","u":["妆台宝镜夜生寒","照见朱颜岁月残","莫道无情能写貌","人生只作画中看"]},
{"t":"郊野春望","g":"五律","u":["东郊二月时","草色绿参差","柳重烟方湿","花明雨乍移","牛羊下远陌","凫雁满横陂","独立苍茫久","春风人未知"]},
{"t":"夏夜纳凉","g":"五律","u":["暑退晚风长","追凉到野塘","蛙声喧暗柳","萤火点回廊","竹动时惊鹊","荷翻忽送香","夜深犹不寐","露坐数星光"]},
{"t":"秋日登楼","g":"五律","u":["落日此楼头","秋随江水流","雁声催木叶","人影立汀洲","世事浮云变","乡心孤月留","凭栏一长啸","天地入清秋"]},
{"t":"冬晓","g":"五律","u":["纸帐透晨曦","梅梢雪压枝","寒鸡催晓早","冻雀下檐迟","冰痕凝石磴","霜气入柴篱","起来呵冻笔","题作岁寒诗"]},
{"t":"归田","g":"五律","u":["久客风尘倦","归来故苑扉","旧畦春雨足","新竹晓烟微","童稚欢迎拜","鸡豚各自肥","晚来一壶酒","坐看月华飞"]},
{"t":"江村晚眺","g":"五律","u":["极目江天暮","孤帆带落曛","远树粘天直","轻鸥贴浪分","渔灯三两点","戍角半霄闻","凭栏不能去","钟声隔浦云"]},
{"t":"山行遇樵者","g":"五律","u":["行尽千岩曲","樵歌下碧湾","肩薪穿薄雾","踏叶破霜斑","问我何为者","看云自往还","一笑无言别","落叶满空山"]},
{"t":"过古战场","g":"五律","u":["落日大荒外","萧萧古战场","沙痕埋旧甲","草根蚀残枪","鬼火明秋垒","悲风撼夕阳","将军百战地","白骨卧苍茫"]},
{"t":"村居","g":"五律","u":["卜居溪上好","门巷入云烟","鸡犬声中隐","桑麻影里眠","春畦添夜雨","稚子放风鸢","最喜升平世","人人乐有年"]},
{"t":"舟中晓望","g":"五律","u":["残月堕江口","孤帆催晓行","远山云外白","高树雾中明","雁引乡心远","潮牵客梦惊","朝来无处所","唯见海霞生"]},
{"t":"秋怀","g":"七律","u":["西风昨夜过高林","吹作萧萧秋意深","月转廊西窥客梦","虫吟砌下伴离心","一身万里常为客","百事无成雪满簪","赖有寒梅最相慰","暗香时复入孤琴"]},
{"t":"春晴","g":"七律","u":["积雨初收万象新","东风着意柳条匀","山含宿雾青如洗","水漾轻鸥绿似茵","佳日每逢须尽兴","流年暗换不饶人","最喜小园蜂蝶闹","闹中时见一年春"]},
{"t":"夏日山居","g":"七律","u":["长夏山居分外清","松涛竹韵和溪声","云归半岭山如洗","花发疏篱昼自明","客至旋烹新雨茗","兴来漫扫落花坪","日长睡起无情思","闲看儿童戏晚晴"]},
{"t":"冬日感怀","g":"七律","u":["岁暮江城雪作堆","北风日夜撼疏梅","寒侵破屋三重席","冻落危檐一寸苔","壮志已随流水去","乡书又逐塞鸿来","围炉且尽杯中物","共待春风送暖回"]},
{"t":"遣怀","g":"七律","u":["少日曾期万里游","中年却赋一庭秋","书藏千卷身将老","剑负十年心已休","小阁焚香听夜雨","孤舟载梦入寒流","此身合是江湖客","笑拨炉灰理钓钩"]},
{"t":"旅宿","g":"七律","u":["旅馆寒灯夜向晨","隔窗风雪更愁人","乡山渐远书难寄","世路多歧志未伸","孤梦每随归雁断","壮怀空对旧星辰","明发又乘征骑去","马蹄踏碎一溪银"]},
{"t":"湖上晚归","g":"七律","u":["日暮湖光漾晚霞","画船归尽柳丝斜","远岫渐随烟霭没","断桥犹带夕阳赊","菱歌唱罢莲舟远","塔影沉时暝色遮","最是湖山情不尽","一钩新月上芦花"]},
{"t":"老将","g":"七律","u":["少小从军鬓已稀","归来空对旧渔矶","三边月色曾随马","万里风烟未减威","儿辈岂知战伐苦","老来犹着去时衣","夜半梦回鼙鼓急","起看天际雁南飞"]},
{"t":"书斋","g":"七律","u":["小斋高敞对横塘","竹树阴阴覆短墙","满架青山供卧读","一庭花影伴焚香","闲来命笔皆成趣","老去论诗更觉狂","莫道书生无事业","也曾灯火著文章"]},
{"t":"初夏","g":"七律","u":["首夏村居事事闲","绿阴如水掩柴关","新篁解箨声初定","乳燕学飞影未还","麦浪翻云黄欲遍","秧针插水绿成斑","田家自有田家乐","不必人间更觅山"]}
]
