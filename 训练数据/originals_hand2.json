[
{"t":"咏荷","g":"七绝","u":["碧叶层云拥粉霞","风翻绿浪影横斜","清香不为无人减","开遍南塘自作花"]},
{"t":"咏荷","g":"五绝","u":["出水净无尘","亭亭不染身","清香风递远","明月共为邻"]},
{"t":"咏梅","g":"七绝","u":["万木凋零独自芳","冰姿何惧雪茫茫","夜深风定月华冷","一缕清香暗里藏"]},
{"t":"咏菊","g":"七绝","u":["不逐春风斗艳姿","甘陪秋色立东篱","寒香到骨清如许","肯与繁华争一时"]},
{"t":"咏雪","g":"七绝","u":["六出飞花天地白","谁将琼玉满城栽","夜深梅蕊忽相映","疑是春光昨夜来"]},
{"t":"咏雁","g":"七绝","u":["万里云天字字横","霜风列阵向南征","芦花深处眠秋水","不恋人间烟火城"]},
{"t":"咏剑","g":"七绝","u":["淬火千回锋刃霜","匣中龙吼夜生光","平生不平事多少","借尔一挥天下凉"]},
{"t":"咏茶","g":"七绝","u":["谷雨初晴摘嫩芽","瓦铛声里煮云霞","一瓯饮罢浑无事","两腋清风便是家"]},
{"t":"咏酒","g":"七绝","u":["一壶浊酒慰平生","醉里乾坤分外明","世上不平千万斛","都付醺然一笑轻"]},
{"t":"咏古琴","g":"七绝","u":["七弦一动万籁低","弹到无人山月西","古调自知非世好","高山流水梦中迷"]},
{"t":"咏长城","g":"七绝","u":["万里苍龙卧碧山","烽烟散尽白云闲","当年多少征人骨","都在迢迢雉堞间"]},
{"t":"咏黄河","g":"七绝","u":["一带黄流天上回","奔雷万里撼山来","千年淘尽英雄骨","只有涛声日夜催"]},
{"t":"洞庭湖","g":"五律","u":["八月洞庭阔","涵虚一望苍","风微波自远","木落雁初翔","帆影迷湘浦","钟声出岳阳","凭栏怀屈子","秋思满沧浪"]},
{"t":"大漠","g":"五绝","u":["平沙万里霜","风卷暮云黄","一片征人月","清辉照战场"]},
{"t":"草原","g":"五绝","u":["天阔接穷原","风低草浪翻","牧歌牛背起","飞鸟没云根"]},
{"t":"溪流","g":"五绝","u":["一水出深山","泠泠白石间","奔流从此去","不肯一时闲"]},
{"t":"渔火","g":"五绝","u":["夜静水云寒","孤灯明灭残","照见舟人影","霜满一江滩"]},
{"t":"砧声","g":"七绝","u":["万户砧声动四邻","寒衣欲寄陇头人","捣残秋月三千遍","捣不开眉一点颦"]},
{"t":"鹧鸪","g":"五绝","u":["啼破岭南烟","双飞楚水边","声声行不得","客泪落樽前"]},
{"t":"梧桐","g":"五绝","u":["一叶落庭前","秋声到枕边","潇潇连夜雨","滴碎不成眠"]},
{"t":"芭蕉","g":"五绝","u":["窗外绿云舒","秋来影渐疏","夜阑听骤雨","点滴在庭除"]},
{"t":"白鹭","g":"七绝","u":["雪羽翩翩立钓矶","一行斜破晚烟飞","平生只饮清溪水","肯落尘寰染是非"]},
{"t":"鸥鸟","g":"五绝","u":["浩荡逐轻舟","忘机水自流","一竿风月里","不管世间秋"]},
{"t":"白发","g":"五绝","u":["览镜忽心惊","霜华两鬓生","功名成底事","输与一竿轻"]}
]
